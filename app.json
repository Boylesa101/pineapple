{
  "expo": {
    "name": "Pineapple",
    "slug": "pineapple",
    "version": "1.7.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pineapple",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1EAAF0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pineapple.travel",
      "buildNumber": "35"
    },
    "android": {
      "versionCode": 42,
      "package": "com.pineapple.travel",
      "adaptiveIcon": {
        "backgroundColor": "#F7E7CE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/icons/pineapple (2)/android/icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#1E2A38",
      "backgroundColor": "#F7E7CE",
      "shortName": "Pineapple"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      "expo-local-authentication",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-sqlite",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Pineapple to scan travel documents with live edge detection."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
