# Copy this file to android/keystore.properties and replace the placeholder values
# before creating a Play Store upload bundle. Do not commit the real file.
PINEAPPLE_UPLOAD_STORE_FILE=pineapple-upload.jks
PINEAPPLE_UPLOAD_STORE_PASSWORD=replace-me
PINEAPPLE_UPLOAD_KEY_ALIAS=pineapple-upload
PINEAPPLE_UPLOAD_KEY_PASSWORD=replace-me
