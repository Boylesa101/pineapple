# Supabase project "copacetic-portal" (London). Publishable values only; no service role key is needed in Phase 1.
NEXT_PUBLIC_SUPABASE_URL=https://dcupbtreveatutogouhl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_plTWqMl714P9ns7j1Mskng_ALodx1KY

# Where the portal is served; used in invite and sign-in links.
PORTAL_URL=http://localhost:3000

# Optional. Without it, invitation emails aren't sent and the admin page shows the link to copy.
RESEND_API_KEY=
EMAIL_FROM="copacetic.web <portal@your-domain>"

# Optional. Where "content submitted" notifications are emailed.
AGENCY_NOTIFY_EMAIL=

# Required for file uploads to be marked checked. Generate with: openssl rand -hex 32
# then store the same value in Supabase Vault (SQL editor):
#   select vault.create_secret('<the value>', 'media_signing_secret');
MEDIA_SIGNING_SECRET=

# ---- Asana sync (Phase 3). Leave blank until Asana is set up; jobs wait in the database meanwhile.
# Supabase secret key (Project settings > API keys > Secret keys). Server-only; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Generate with: openssl rand -hex 32, then store the same value and the run URL in Supabase Vault:
#   select vault.create_secret('<the value>', 'jobs_secret');
#   select vault.create_secret('https://<portal domain>/api/jobs/run', 'jobs_url');
JOBS_SECRET=
# An Asana personal access token (ideally from a dedicated "copacetic.web portal" Asana account).
ASANA_TOKEN=
ASANA_WORKSPACE_GID=1169581892431343
# The copacetic.web team (Asana > team page; the number in the URL).
ASANA_TEAM_GID=
# Who new tasks are assigned to (and who owns new projects).
ASANA_ASSIGNEE_GID=1169581891186906
